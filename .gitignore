# Root .gitignore for SkillSift

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
target/
*.class
*.jar
*.war

# Environment & secrets
.env
.env.local
.env.*.local
application-dev.properties
application-secret.properties
*.pem
*.key

# IDEs & OS
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
